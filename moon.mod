// Learn more about moon.mod configuration:
// https://docs.moonbitlang.com/en/latest/toolchain/moon/module.html

name = "FFTopOne/moonbit-proptest"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/FFTopOne/moonbit-proptest"

license = "Apache-2.0"

keywords = [
  "property-based-testing",
  "fuzzing",
  "quickcheck",
  "shrinking",
  "testing",
]

preferred_target = "wasm"

description = "Integrated-shrinking property testing and fuzzing for MoonBit, with replayable counterexamples, coverage gates, and model-based state machine testing."
